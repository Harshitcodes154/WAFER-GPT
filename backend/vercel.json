{
  "version": 2,
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/uploads/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/gradcam/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/predict",
      "dest": "backend/main.py"
    },
    {
      "src": "/chat",
      "dest": "backend/main.py"
    },
    {
      "src": "/health",
      "dest": "backend/main.py"
    },
