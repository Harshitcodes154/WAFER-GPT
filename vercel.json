{
  "rewrites": [
    {
      "source": "/predict",
      "destination": "backend/main.py"
    },
    {
      "source": "/chat",
      "destination": "backend/main.py"
    },
    {
      "source": "/health",
      "destination": "backend/main.py"
    },
    {
      "source": "/uploads/:path*",
      "destination": "backend/main.py"
    },
    {
      "source": "/gradcam/:path*",
      "destination": "backend/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
