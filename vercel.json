{
  "rewrites": [
    {
      "source": "/predict",
      "destination": "backend/main.py"
    },
    {
      "source": "/chat",
      "destination": "backend/main.py"
    },
    {
      "source": "/health",
      "destination": "backend/main.py"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "backend/main.py"
    },
    {
      "source": "/gradcam/(.*)",
      "destination": "backend/main.py"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/style.css",
      "destination": "/frontend/style.css"
    },
    {
      "source": "/script.js",
      "destination": "/frontend/script.js"
    }
  ]
}
